# Источник данных организаторов: GET {DATA_API_URL}?group_id=DEV
DATA_API_URL=
DATA_API_TIMEOUT_S=30
# SQLite
DB_PATH=data/cqa.db
# Источники, которым разрешён доступ к API из браузера (через запятую); пусто — только тот же источник
CORS_ORIGINS=
# Локальные наборы data/{group_id}.json
DATA_DIR=data
# Имя команды в results.json для сдачи (scripts/export_results.py, GET /api/export)
TEAM_NAME=

# --- LLM ---
# anthropic | gemini | ollama | groq | openrouter | openai | vllm — профили в backend/llm/__init__.py:
# модель, адрес, переменная ключа, RATE_LIMIT_RPM, таймаут и параллельность по умолчанию; любое значение ниже их переопределяет.
#   Gemini (бесплатный тариф, 20 запросов/сутки на модель): LLM_PROVIDER=gemini  GEMINI_API_KEY=<ключ AI Studio>  (модель gemini-3.8-flash, RPM 5)
#   Ollama (локально, бесплатно):                           LLM_PROVIDER=ollama  (модель cqa-qwen14b, http://localhost:11434/v1)
#   Groq:                                                   LLM_PROVIDER=groq  GROQ_API_KEY=<ключ>  (llama-3.3-70b-versatile, RPM 30)
#   OpenRouter:                                             LLM_PROVIDER=openrouter  OPENROUTER_API_KEY=<ключ>  LLM_MODEL=<модель>
#   любой OpenAI-совместимый адрес:                         LLM_PROVIDER=openai  LLM_BASE_URL=http://host/v1  LLM_MODEL=…  LLM_API_KEY=…
LLM_PROVIDER=anthropic
# модель; пусто — из профиля провайдера (anthropic: claude-opus-5-5, gemini: gemini-3.8-flash, ollama: cqa-qwen14b)
LLM_MODEL=
# модель конкретного вида провайдера — важнее LLM_MODEL (переключение LLM_PROVIDER не тянет чужую модель)
GEMINI_MODEL=
OLLAMA_MODEL=
# адрес OpenAI-совместимого API; пусто — из профиля
LLM_BASE_URL=
# ключ; для anthropic можно не задавать, если есть ANTHROPIC_API_KEY или профиль `ant auth login`
LLM_API_KEY=
# anthropic: глубина рассуждения low|medium|high|xhigh|max
LLM_EFFORT=high
# anthropic: серверный fallback на другую модель при отказе (1/0)
LLM_FALLBACKS=1
LLM_MAX_TOKENS=16000
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=3
# одновременных вызовов модели (семафор на процесс)
LLM_CONCURRENCY=8
# не чаще N запросов в минуту (бесплатные тарифы); 0 — без ограничения
RATE_LIMIT_RPM=0
# при 429: пауза RATE_LIMIT_BACKOFF_S × 2^n секунд, до RATE_LIMIT_ATTEMPTS повторов
RATE_LIMIT_BACKOFF_S=15
RATE_LIMIT_ATTEMPTS=5
# режим вызовов: per_criterion — вызов на критерий (точнее); per_dialog — один вызов на диалог (экономия запросов)
EVAL_MODE=per_criterion
# цены USD за 1M токенов (для известных моделей Claude есть значения по умолчанию)
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
LLM_PRICE_CACHE_READ_PER_MTOK=
LLM_PRICE_CACHE_WRITE_PER_MTOK=
# голосов на критерий: 1 для разработки, 3 для финального прогона
VOTES=1
# нормализация текста звонков моделью-корректором перед оценкой (этап 5): 1/0.
# Результат кэшируется по диалогу и версии корректора; оригинальный текст не меняется.
NORMALIZE_CALLS=0
